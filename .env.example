PORT=3000
API_KEY=replace-with-a-long-random-secret
RESUME_TEMPLATE_PATH=templates/resume-template.docx
# Optional: path to the mock employee dataset (defaults to src/data/employees.json)
# EMPLOYEE_DATA_PATH=src/data/employees.json

# Practice project: leave API_KEY blank to disable auth (required for Lyzr "No Auth" tools).
# Download links in POST /resumes responses:
# PUBLIC_BASE_URL=https://your-service.onrender.com   (Render sets RENDER_EXTERNAL_URL automatically)
# ARTIFACT_TTL_MINUTES=60
# ARTIFACT_MAX_FILES=20
